subscription_id = "cc9bc945-4e68-4631-a463-3bf91022981b"
location = "centralindia"
resource_group_name = "rg-zero-to-prod-dev"
system_node_count = 1
system_node_vm_size = "Standard_D2s_v3"
# Required before plan/apply: replace with your current public IPv4 CIDR.
# Example only; replace 203.0.113.10 with your public IP.
# api_server_authorized_ip_ranges = ["203.0.113.10/32"]
pod_cidr = "192.168.0.0/16"
# Optionally set a globally unique lowercase alphanumeric name (5-50 chars).
# acr_name = "ztdcapstone12345"

# Optional self-hosted SonarQube VM (additional cost). Keep disabled unless needed.
deploy_sonarqube = false
# If enabled, replace this with a trusted client CIDR before apply.
sonarqube_ingress_cidr = "127.0.0.1/32"
