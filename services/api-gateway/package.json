{
  "name": "api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Edge API gateway proxying catalog and orders services",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
